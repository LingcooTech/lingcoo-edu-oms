NODE_ENV=development
APP_NAME=lingcoo-edu-oms
APP_VERSION=development
APP_PUBLIC_URL=http://localhost:5173
API_HOST=0.0.0.0
API_PORT=8090
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
DATABASE_URL=postgres://app:app_password@localhost:5438/app
API_DOCS_ENABLED=true
TRUST_PROXY=false
LOG_LEVEL=info
JOBS_POLL_INTERVAL_MS=1000
JOBS_CONCURRENCY=5
JOBS_HEARTBEAT_INTERVAL_MS=10000
JOBS_SHUTDOWN_GRACE_MS=30000
JOBS_STALE_RECOVERY_BATCH=100
JOBS_RETENTION_DAYS=30
JOBS_MAINTENANCE_INTERVAL_MS=3600000
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_CONCURRENCY=5
OUTBOX_HEARTBEAT_INTERVAL_MS=10000
OUTBOX_SHUTDOWN_GRACE_MS=30000
OUTBOX_STALE_RECOVERY_BATCH=100
OUTBOX_RETENTION_DAYS=30
OUTBOX_MAINTENANCE_INTERVAL_MS=3600000
AUTH_SESSION_TTL_SECONDS=604800
AUTH_ACTION_TOKEN_TTL_SECONDS=3600
AUTH_COOKIE_NAME=app_session
AUTH_CSRF_COOKIE_NAME=app_csrf
VITE_AUTH_CSRF_COOKIE_NAME=app_csrf
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
AUTH_EXPOSE_TEST_TOKENS=true
SETTINGS_ENCRYPTION_CURRENT_KEY_ID=development
SETTINGS_ENCRYPTION_KEYS={"development":"development-only-settings-key-change-me"}
SUPPORT_EMAIL=
MAIL_TRANSPORT=capture
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=
MAIL_RETENTION_DAYS=30
MAIL_MAINTENANCE_INTERVAL_MS=3600000
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=.data/storage
STORAGE_MAX_UPLOAD_BYTES=26214400
STORAGE_UPLOAD_EXPIRY_SECONDS=900
STORAGE_PENDING_RETENTION_HOURS=24
STORAGE_MAINTENANCE_INTERVAL_MS=3600000
# 七牛 Kodo 可通过现有 S3 Provider 接入；Region、Endpoint 必须使用同一空间对应的区域。
# 示例：Region=cn-east-1，Endpoint=https://s3.cn-east-1.qiniucs.com；不要把真实 AK/SK 提交到仓库。
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
# 七牛通常使用 false（虚拟主机寻址）；只有端点或网络环境要求时才改为 true。
STORAGE_S3_FORCE_PATH_STYLE=false
PAYMENTS_MOCK_APP_ID=mock-app
PAYMENTS_MOCK_MERCHANT_ID=mock-merchant
PAYMENTS_MOCK_SIGNING_SECRET=
WECHAT_MINI_PROGRAM_ENABLED=false
WECHAT_MINI_PROGRAM_APP_ID=
WECHAT_MINI_PROGRAM_APP_SECRET=
WECHAT_MINI_PROGRAM_STATE=formal
WECHAT_MINI_PROGRAM_SESSION_REMINDER_TEMPLATE_ID=
WECHAT_MINI_PROGRAM_LESSON_CONSUMPTION_TEMPLATE_ID=
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APP_ID=
WECHAT_PAY_MERCHANT_ID=
WECHAT_PAY_MERCHANT_SERIAL_NUMBER=
WECHAT_PAY_MERCHANT_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY=
WECHAT_PAY_NOTIFY_URL=
NOTION_CONTENT_SOURCE_ENABLED=false
NOTION_API_TOKEN=
NOTION_API_VERSION=2026-03-11
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=replace-with-at-least-12-characters
