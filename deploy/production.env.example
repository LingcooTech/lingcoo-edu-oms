NODE_ENV=production
APP_NAME=lingcoo-edu-oms
APP_PUBLIC_URL=https://your-domain.example.com
APP_VERSION=replace-with-git-sha
CORS_ORIGIN=https://your-domain.example.com
API_DOCS_ENABLED=false
TRUST_PROXY=true
LOG_LEVEL=info
JOBS_POLL_INTERVAL_MS=1000
JOBS_CONCURRENCY=5
JOBS_HEARTBEAT_INTERVAL_MS=10000
JOBS_SHUTDOWN_GRACE_MS=30000
JOBS_STALE_RECOVERY_BATCH=100
JOBS_RETENTION_DAYS=30
JOBS_MAINTENANCE_INTERVAL_MS=3600000
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_CONCURRENCY=5
OUTBOX_HEARTBEAT_INTERVAL_MS=10000
OUTBOX_SHUTDOWN_GRACE_MS=30000
OUTBOX_STALE_RECOVERY_BATCH=100
OUTBOX_RETENTION_DAYS=30
OUTBOX_MAINTENANCE_INTERVAL_MS=3600000
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
AUTH_EXPOSE_TEST_TOKENS=false
SETTINGS_ENCRYPTION_CURRENT_KEY_ID=production-v1
SETTINGS_ENCRYPTION_KEYS={"production-v1":"replace-with-a-random-secret-at-least-32-characters"}
SUPPORT_EMAIL=support@your-domain.example.com
MAIL_TRANSPORT=capture
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=
MAIL_RETENTION_DAYS=30
MAIL_MAINTENANCE_INTERVAL_MS=3600000
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=/app/data/storage
STORAGE_MAX_UPLOAD_BYTES=26214400
STORAGE_UPLOAD_EXPIRY_SECONDS=900
STORAGE_PENDING_RETENTION_HOURS=24
STORAGE_MAINTENANCE_INTERVAL_MS=3600000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false
PAYMENTS_MOCK_APP_ID=mock-app
PAYMENTS_MOCK_MERCHANT_ID=mock-merchant
PAYMENTS_MOCK_SIGNING_SECRET=replace-with-a-random-secret-at-least-32-characters
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=replace-with-a-random-password-at-least-12-characters

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-a-random-value
DATABASE_URL=postgres://app:replace-with-a-random-value@postgres:5432/app

APP_IMAGE=replace-with-registry/app:git-sha
# 可替换为国内镜像缓存或企业镜像仓库中的同版本镜像
POSTGRES_IMAGE=postgres:17-alpine
CADDY_IMAGE=caddy:2-alpine
HTTP_PORT=18093
CADDY_SITE_ADDRESS=:80
